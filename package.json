{
  "name": "tarmdas",
  "version": "0.1.0",
  "description": "本地、完全離線的 Markdown → 單一 HTML 轉換工具（支援 KaTeX、Mermaid、SCSS/LESS、Live Reload）",
  "type": "module",
  "bin": {
    "tarmdas": "bin/tarmdas.js"
  },
  "exports": {
    ".": "./src/convert.js"
  },
  "files": [
    "bin",
    "src",
    "themes"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "node bin/tarmdas.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "markdown",
    "html",
    "converter",
    "katex",
    "mermaid",
    "offline",
    "scss",
    "less"
  ],
  "license": "MIT",
  "dependencies": {
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.4.0",
    "sass": "^1.80.0"
  },
  "optionalDependencies": {
    "less": "^4.2.0"
  }
}
